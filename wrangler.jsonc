{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gmail-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "NODE_ENV": "production",
    "MCP_NAME": "gmail-mcp",
    "MCP_TITLE": "Gmail",
    "MCP_VERSION": "1.0.0",
    "MCP_PUBLIC_URL": "https://gmail-mcp.example.workers.dev/mcp",
    "MCP_ALLOWED_HOSTS": "gmail-mcp.example.workers.dev",
    "MCP_ALLOWED_ORIGIN_HOSTNAMES": "gmail-mcp.example.workers.dev,claude.ai,claude.com",
    "MCP_LEGACY_MODE": "stateless",
    "MCP_MAX_REQUEST_BYTES": "1048576",
    "AUTH_ENABLED": "true",
    "AUTH_STRATEGY": "oauth",
    "PROVIDER_ACCOUNTS_URL": "https://accounts.google.com",
    "OAUTH_AUTHORIZATION_URL": "https://accounts.google.com/o/oauth2/v2/auth",
    "OAUTH_TOKEN_URL": "https://oauth2.googleapis.com/token",
    "OAUTH_REVOCATION_URL": "https://oauth2.googleapis.com/revoke",
    "OAUTH_SCOPES": "https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/gmail.modify",
    "OAUTH_EXTRA_AUTH_PARAMS": "access_type=offline&prompt=consent",
    "OAUTH_REDIRECT_ALLOW_ALL": "false",
    "OAUTH_REDIRECT_ALLOWLIST": "alice://oauth/callback,https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback",
    "OAUTH_REDIRECT_URI": "https://gmail-mcp.example.workers.dev/oauth/callback",
    "CIMD_ENABLED": "true",
    "LOG_LEVEL": "info"
  },
  // Set PROVIDER_CLIENT_ID, PROVIDER_CLIENT_SECRET, and RS_TOKENS_ENC_KEY
  // with `wrangler secret put`; never add their values to vars.
  "kv_namespaces": [
    {
      "binding": "TOKENS",
      "id": "00000000000000000000000000000000"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
