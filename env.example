# Bun resource server
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
MCP_NAME=gmail-mcp
MCP_TITLE=Gmail
MCP_VERSION=1.0.0
MCP_PUBLIC_URL=http://127.0.0.1:3000/mcp
MCP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
MCP_ALLOWED_ORIGIN_HOSTNAMES=127.0.0.1,localhost,[::1]
MCP_LEGACY_MODE=stateless
MCP_MAX_REQUEST_BYTES=1048576
MCP_INSTRUCTIONS="Start with inbox_overview. Use returned thread IDs and addresses rather than guessing."
LOG_LEVEL=info

# The protocol target is fixed in source at the 2026-07-28 candidate.
# Packages remain pinned to v2.0.0-beta.5 until the final-release gate passes.

# Opaque MCP resource-token -> Gmail provider-token authorization
AUTH_ENABLED=true
AUTH_STRATEGY=oauth
# Defaults to OAUTH_SCOPES. Override only for deliberate partial-scope policy.
AUTH_REQUIRED_SCOPES=

# Google OAuth web application credentials (secrets; do not commit real values)
PROVIDER_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
PROVIDER_CLIENT_SECRET=your-google-client-secret
PROVIDER_ACCOUNTS_URL=https://accounts.google.com
OAUTH_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
OAUTH_REVOCATION_URL=https://oauth2.googleapis.com/revoke
OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/gmail.modify
OAUTH_EXTRA_AUTH_PARAMS=access_type=offline&prompt=consent

# Bun runs this OAuth proxy on PORT + 1. Set OAUTH_PROXY_PUBLIC_URL when its
# externally visible origin differs from the derived MCP host and PORT + 1.
OAUTH_PROXY_PUBLIC_URL=http://127.0.0.1:3001
OAUTH_REDIRECT_URI=http://127.0.0.1:3001/oauth/callback
OAUTH_REDIRECT_ALLOWLIST=alice://oauth/callback,http://127.0.0.1:3001/oauth/callback
OAUTH_REDIRECT_ALLOW_ALL=false

# SEP-991 Client ID Metadata Documents
CIMD_ENABLED=true
CIMD_FETCH_TIMEOUT_MS=5000
CIMD_MAX_RESPONSE_BYTES=65536
CIMD_ALLOWED_DOMAINS=

# Bun token records keep the existing FileTokenStore v1 format.
RS_TOKENS_FILE=.data/rs_tokens.json
# Base64url-encoded 32-byte AES-256-GCM key. Required for encrypted records.
RS_TOKENS_ENC_KEY=
