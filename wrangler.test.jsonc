{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gmail-mcp-protocol-test",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NODE_ENV": "test",
    "MCP_NAME": "gmail-mcp",
    "MCP_TITLE": "Gmail",
    "MCP_VERSION": "1.0.0",
    "MCP_PUBLIC_URL": "http://localhost:8787/mcp",
    "MCP_ALLOWED_HOSTS": "localhost,127.0.0.1,[::1]",
    "MCP_ALLOWED_ORIGIN_HOSTNAMES": "localhost,127.0.0.1,[::1]",
    "MCP_LEGACY_MODE": "stateless",
    "MCP_MAX_REQUEST_BYTES": "1048576",
    "AUTH_ENABLED": "false",
    "AUTH_STRATEGY": "none",
    "OAUTH_SCOPES": "https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/gmail.modify",
    "OAUTH_REDIRECT_URI": "http://localhost:8787/oauth/callback",
    "LOG_LEVEL": "error"
  },
  "kv_namespaces": [
    {
      "binding": "TOKENS",
      "id": "00000000000000000000000000000000"
    }
  ]
}
